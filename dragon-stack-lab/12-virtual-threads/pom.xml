<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.harry.lab</groupId>
        <artifactId>dragon-stack-lab</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>12-virtual-threads</artifactId>
    <description>虚拟线程：三种创建方式、与平台线程的并发密度差异、ThreadLocal 与 pinning 的风险</description>

    <dependencies>
        <!--
            需要 webmvc 是因为本模块多了一个极简 Controller，用来验证
            spring.threads.virtual.enabled 这个开关是否真的把请求跑在虚拟线程上。
            只写 spring-boot-starter 时没有内嵌 Tomcat，配置项无从验证。
            webmvc starter 已经包含 spring-boot-starter，不必重复声明。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
    </dependencies>

</project>
