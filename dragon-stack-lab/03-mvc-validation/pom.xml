<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.harry.lab</groupId>
        <artifactId>dragon-stack-lab</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>03-mvc-validation</artifactId>
    <description>Web 接入：@RestController 路由、@RequestBody 反序列化、@Valid 参数校验、@RestControllerAdvice 统一异常</description>

    <dependencies>
        <!--
            Spring Boot 4 里 Web MVC 的 starter 名字变了。
            第一，Boot 3 时代叫 spring-boot-starter-web，Boot 4 拆成了 webmvc 与 webflux 两个。
            第二，harness_saas 的 pom.xml 里写的就是 spring-boot-starter-webmvc。
            第三，照 Boot 3 的老教程写 starter-web 不行：Boot 4 已经删掉这个坐标，
            4.x 下它解析不到，构建会直接失败，而不是「仍能拉到」。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!--
            参数校验不是 Web starter 自带的。没有这个依赖，@NotBlank 这类注解
            不会报错也不会生效，是最容易静默失败的地方。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

</project>
