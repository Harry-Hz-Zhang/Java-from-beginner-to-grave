<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.harry.lab</groupId>
        <artifactId>dragon-stack-lab</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>02-config-properties</artifactId>
    <description>配置绑定：record 型 @ConfigurationProperties、@DefaultValue、紧凑构造器校验、自定义类型转换、profile 覆盖</description>

    <dependencies>
        <!-- 只需要容器与配置绑定能力，不需要 Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!--
            @Validated 触发的是 Jakarta Bean Validation，只有注解没有实现是不会生效的。
            starter 带来 hibernate-validator 与 jakarta.validation-api，
            @NotNull、@Min 才会在绑定之后真正执行。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

</project>
