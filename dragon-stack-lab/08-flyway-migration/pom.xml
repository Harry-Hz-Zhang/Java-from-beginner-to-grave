<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.harry.lab</groupId>
        <artifactId>dragon-stack-lab</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>08-flyway-migration</artifactId>
    <description>数据库版本化：V 前缀命名规则、启动自动迁移、历史表与校验和、改已执行脚本为什么会失败</description>

    <dependencies>
        <!--
            Spring Boot 4 提供了 flyway 专用的 starter，它会带来 flyway-core 并触发自动迁移。
            harness_saas 用的就是 spring-boot-starter-flyway，另外还加了 flyway-mysql
            来处理 MySQL 专有语法。这里连的是 H2，不需要额外方言包。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

</project>
