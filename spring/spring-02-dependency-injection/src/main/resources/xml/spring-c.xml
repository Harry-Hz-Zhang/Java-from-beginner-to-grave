<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:c="http://www.springframework.org/schema/c"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- c 命名空间的前提条件有两个：
         1. 头部加上 xmlns:c="http://www.springframework.org/schema/c"
         2. 目标类必须提供构造方法，MyTime 只有三参构造、没有 setter -->

    <!-- c:_0 c:_1 c:_2 表示按构造参数的下标赋值，下标从 0 开始。
         如果编译时保留了参数名（maven.compiler.parameters=true），
         也可以写成 c:year="2008" c:month="8" c:day="8" -->
    <bean id="myTimeBean" class="org.harry.simple.entity.MyTime"
          c:_0="2008" c:_1="8" c:_2="8"/>

</beans>
